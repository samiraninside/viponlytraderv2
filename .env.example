# VIPONLYTRADER Agent Engine Environment Variables
# Copy this file to .env and fill in your values before running

# ==================== Dhan API Credentials ====================
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_access_token
DHAN_WS_URL=wss://api-feed.dhan.co
DHAN_REST_URL=https://api.dhan.co

# ==================== Database Configuration ====================
# SQLite for local dev; swap to PostgreSQL for production
DATABASE_URL=sqlite:///./data/trading_engine.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/trading_engine

# ==================== Market Schedule (IST) ====================
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30
PRE_MARKET_TIME=08:30

# ==================== Signal & Risk Configuration ====================
MAX_SIGNALS_PER_DAY=10
MIN_CONFIDENCE_SCORE=0.65
MIN_RISK_REWARD_RATIO=1.5

# Tier-based SL caps (INR)
TIER_1_MAX_SL=2000
TIER_2_MAX_SL=5000
TIER_3_MAX_SL=10000

# ==================== Notification Channels ====================
WHATSAPP_API_URL=https://api.callmebot.com/whatsapp.php
WHATSAPP_PHONE=
WHATSAPP_API_KEY=

# Push notification (FCM/APNs)
FCM_SERVER_KEY=
FCM_DEVICE_TOKENS=

# ==================== Optional: Growth Agents ====================
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
HIGGSFIELD_API_KEY=

# ==================== Admin / Webhook ====================
ADMIN_WEBHOOK_URL=
ADMIN_API_KEY=

# ==================== Paper Trading Mode ====================
PAPER_TRADING=true